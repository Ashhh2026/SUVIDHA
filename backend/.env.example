# SUVIDHA Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
# Set MONGODB_URI to your MongoDB Atlas or local connection string
# If left empty or connection fails in dev, SUVIDHA automatically starts an embedded In-Memory MongoDB!
MONGODB_URI=mongodb://localhost:27017/suvidha
USE_MEMORY_DB=auto

# JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET=suvidha_jwt_access_secret_production_ready_dev_key_2026
JWT_REFRESH_SECRET=suvidha_jwt_refresh_secret_production_ready_dev_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security Settings
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Service (Set to true in development to log activation & reset links to console)
EMAIL_SIMULATION=true
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@suvidha.university.edu
